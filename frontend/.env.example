# Port the frontend dev server listens on.
PORT=5173

# development or production.
NODE_ENV=development

# URL of the backend API, exposed to the browser. Required -- every page that
# talks to the backend reads this.
PUBLIC_BACKEND_URL=http://localhost:5172

# The vars below are inherited from src/config/env.ts but aren't currently
# read by any frontend code -- safe to leave as-is.
BETTER_AUTH_SECRET=your_secret_key_here
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:5172
