# Variables read by docker-compose.yml. Copy to .env and fill in before
# running `docker compose up --build`.

# Postgres credentials (used by the postgres container and assembled into
# the backend's DATABASE_URL automatically -- no need to set DATABASE_URL
# yourself).
POSTGRES_USER=ticket_system
POSTGRES_PASSWORD=change_me
POSTGRES_DB=ticket_system

# Secret Better Auth uses to sign session tokens. Generate with e.g.
# `openssl rand -base64 32`. Required.
BETTER_AUTH_SECRET=

# Shared secret sent to the NLP service; must match between backend and
# nlp_service. Generate with e.g. `openssl rand -hex 32`. Required.
NLP_API_KEY=

# Public-facing URLs. On a remote host, replace localhost with the
# host's domain/IP -- these get baked into the frontend build and used
# for CORS + cookie config, so they must match what the browser sees.
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:5172
PUBLIC_BACKEND_URL=http://localhost:5172

# Host ports to publish (defaults shown).
FRONTEND_PORT=5173
BACKEND_PORT=5172

# Optional: password for the seeded superuser admin account (create_admin script).
SUPERUSER_PASSWORD=
