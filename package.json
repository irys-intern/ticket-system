{
  "name": "ticket-system",
  "version": "1.0.0",
  "description": "this is gonna be something folks",
  "keywords": [
    "ticket"
  ],
  "homepage": "https://github.com/irys-intern/ticket-system#readme",
  "bugs": {
    "url": "https://github.com/irys-intern/ticket-system/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/irys-intern/ticket-system.git"
  },
  "license": "ISC",
  "author": "Eli Friedman",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "vitest",
    "lint": "eslint src --ext .ts",
    "format": "prettier --write \"src/**/*.ts\"",
    "db:generate": "drizzle-kit generate:pg",
    "db:migrate": "drizzle-kit migrate:pg",
    "db:push": "drizzle-kit push:pg",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "express": "^5.2.1",
    "cors": "^2.8.5",
    "drizzle-orm": "^0.31.2",
    "postgres": "^3.4.4",
    "better-auth": "^1.0.0",
    "zod": "^3.22.4",
    "dotenv": "^16.3.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^25.9.1",
    "@typescript-eslint/eslint-plugin": "^7.3.1",
    "@typescript-eslint/parser": "^7.3.1",
    "eslint": "^8.57.0",
    "prettier": "^3.2.5",
    "nodemon": "^3.1.14",
    "ts-node": "^10.9.2",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "vitest": "^1.2.0"
  }
}
