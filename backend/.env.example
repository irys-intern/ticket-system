# Port the backend server listens on.
PORT=5172

# development or production.
NODE_ENV=development

# PostgreSQL connection string. Required.
DATABASE_URL=postgres://user:password@localhost:5432/ticket_system

# Redis connection string, used for Better Auth's session cache. Required.
REDIS_URL=redis://localhost:6379

# Secret key Better Auth uses to sign session tokens. Required -- use a long,
# random value in production (e.g. `openssl rand -base64 32`).
BETTER_AUTH_SECRET=your_secret_key_here

# URL of the frontend app. Used to set the CORS allowed origin.
FRONTEND_URL=http://localhost:5173

# URL this backend is reachable at. Passed to Better Auth as its baseURL.
BACKEND_URL=http://localhost:5172

# URL of the NLP service. Used for the admin system health check and the
# priority-suggestion proxy.
NLP_SERVER_URL=http://localhost:8000

# Shared secret sent to the NLP service as the X-NLP-Api-Key header. Must match
# NLP_API_KEY in nlp_service/.env.
NLP_API_KEY=
